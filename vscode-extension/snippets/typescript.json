{
    "Adaptive-K Setup TypeScript": {
        "prefix": "adaptive-k-setup-ts",
        "body": [
            "import { AdaptiveKRouter, EntropyCalculator } from 'adaptive-k-sdk';",
            "",
            "// Initialize Adaptive-K router",
            "const router = new AdaptiveKRouter({",
            "    kValues: [${1:1, 2, 4, 8}],",
            "    entropyThresholds: [${2:0.3, 0.6, 1.2}],",
            "    modelName: '${3:deepseek-v3}'",
            "});",
            "",
            "// Calculate optimal K for input",
            "async function selectOptimalK(hiddenStates: Float32Array): Promise<number> {",
            "    const entropy = EntropyCalculator.compute(hiddenStates);",
            "    const optimalK = router.selectK(entropy);",
            "    console.log(`Selected K=${optimalK} for entropy=${entropy.toFixed(3)}`);",
            "    return optimalK;",
            "}"
        ],
        "description": "Basic Adaptive-K SDK setup in TypeScript"
    },
    "OpenAI with Cost Tracking": {
        "prefix": "openai-adaptive",
        "body": [
            "import OpenAI from 'openai';",
            "",
            "const client = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });",
            "",
            "interface CostEstimate {",
            "    baseline: number;",
            "    withAdaptiveK: number;",
            "    savings: number;",
            "}",
            "",
            "async function chatWithCostTracking(",
            "    messages: OpenAI.ChatCompletionMessageParam[]",
            "): Promise<{ response: OpenAI.ChatCompletion; cost: CostEstimate }> {",
            "    const response = await client.chat.completions.create({",
            "        model: '${1:gpt-4}',",
            "        messages,",
            "    });",
            "",
            "    const tokens = response.usage?.total_tokens ?? 0;",
            "    const pricePerMillion = ${2:0.03}; // USD per 1M tokens",
            "    const baseline = (tokens / 1_000_000) * pricePerMillion;",
            "    const savingsRate = ${3:0.35}; // 35% with Adaptive-K",
            "",
            "    return {",
            "        response,",
            "        cost: {",
            "            baseline,",
            "            withAdaptiveK: baseline * (1 - savingsRate),",
            "            savings: baseline * savingsRate,",
            "        },",
            "    };",
            "}"
        ],
        "description": "OpenAI integration with cost tracking"
    },
    "Together AI Client": {
        "prefix": "together-client",
        "body": [
            "import Together from 'together-ai';",
            "",
            "const together = new Together({ apiKey: process.env.TOGETHER_API_KEY });",
            "",
            "async function chatWithMoE(prompt: string) {",
            "    const response = await together.chat.completions.create({",
            "        model: '${1:deepseek-ai/DeepSeek-V3}',",
            "        messages: [{ role: 'user', content: prompt }],",
            "        max_tokens: ${2:1024},",
            "    });",
            "",
            "    // MoE models benefit most from Adaptive-K",
            "    // DeepSeek-V3: 256 experts, ~35% savings",
            "    // Mixtral: 8 experts, ~52% savings",
            "",
            "    return response.choices[0]?.message?.content;",
            "}"
        ],
        "description": "Together.ai client with MoE model"
    },
    "Cost Calculator": {
        "prefix": "cost-calc",
        "body": [
            "interface ModelPricing {",
            "    name: string;",
            "    inputPrice: number;  // per 1M tokens",
            "    outputPrice: number;",
            "    expectedSavings: number;  // percentage",
            "}",
            "",
            "const MODELS: Record<string, ModelPricing> = {",
            "    'deepseek-v3': { name: 'DeepSeek-V3', inputPrice: 0.14, outputPrice: 0.28, expectedSavings: 35 },",
            "    'mixtral-8x7b': { name: 'Mixtral 8x7B', inputPrice: 0.24, outputPrice: 0.24, expectedSavings: 52.5 },",
            "    'qwen-moe': { name: 'Qwen-MoE', inputPrice: 0.65, outputPrice: 0.65, expectedSavings: 32.4 },",
            "};",
            "",
            "function calculateSavings(tokens: number, modelId: string = 'deepseek-v3') {",
            "    const model = MODELS[modelId];",
            "    const baseline = (tokens / 1_000_000) * model.inputPrice;",
            "    const savings = baseline * (model.expectedSavings / 100);",
            "    return { baseline, withAdaptiveK: baseline - savings, savings };",
            "}"
        ],
        "description": "Cost calculator for MoE models"
    }
}

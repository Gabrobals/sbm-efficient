% NeurIPS 2024 Style File
% Based on official NeurIPS template
% For use with Adaptive-K paper

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/01/01 NeurIPS 2024 submission style]

% Options
\newif\if@preprint\@preprintfalse
\newif\if@final\@finaltrue
\newif\if@nonatbib\@nonatbibfalse

\DeclareOption{preprint}{\@preprinttrue}
\DeclareOption{final}{\@finaltrue\@preprintfalse}
\DeclareOption{nonatbib}{\@nonatbibtrue}
\ProcessOptions\relax

% Required packages
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{natbib}
\RequirePackage{titlesec}
\RequirePackage{abstract}

% Page geometry
\geometry{
  letterpaper,
  margin=1in,
  top=1in,
  bottom=1in,
}

% Two-column format for final
\if@final
  \geometry{
    letterpaper,
    textwidth=6.5in,
    textheight=9in,
    top=1in,
  }
\fi

% Font settings
\renewcommand{\rmdefault}{ptm}  % Times
\renewcommand{\sfdefault}{phv}  % Helvetica
\renewcommand{\ttdefault}{pcr}  % Courier

% Section formatting
\titleformat{\section}
  {\normalfont\large\bfseries}
  {\thesection}{1em}{}
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsection}{1em}{}
\titleformat{\subsubsection}
  {\normalfont\normalsize\itshape}
  {\thesubsubsection}{1em}{}

% Spacing
\titlespacing*{\section}{0pt}{2ex plus 1ex minus .2ex}{1ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.5ex plus 1ex minus .2ex}{0.5ex plus .2ex}

% Abstract formatting
\renewcommand{\abstractnamefont}{\normalfont\bfseries}
\renewcommand{\abstracttextfont}{\normalfont\small}
\setlength{\absleftindent}{0.5in}
\setlength{\absrightindent}{0.5in}

% Header/footer
\pagestyle{fancy}
\fancyhf{}
\if@preprint
  \fancyhead[C]{\small Preprint. Under review.}
\fi
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}

% Title formatting
\def\@maketitle{%
  \newpage
  \null
  \vskip 2em%
  \begin{center}%
    {\LARGE\bfseries \@title \par}%
    \vskip 1.5em%
    {\large
      \lineskip .5em%
      \begin{tabular}[t]{c}%
        \@author
      \end{tabular}\par}%
    \vskip 1em%
    {\large \@date}%
  \end{center}%
  \par
  \vskip 1.5em%
}

% Acknowledgments environment
\newenvironment{ack}{%
  \section*{Acknowledgments}
}{}

% Citation style
\if@nonatbib\else
  \bibliographystyle{plainnat}
  \setcitestyle{authoryear,round}
\fi

\endinput
